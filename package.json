    "coverage:story": "vite-node scripts/coverage-report.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/rapier": "^2.2.0",
    "postprocessing": "^6.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript": "5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
